<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'alienrock-scanner-menu-title'}"
    MinSize="400 300"
    SetSize="400 300"
    Resizable="True"
    >
    <BoxContainer Orientation="Vertical" HorizontalExpand = "True" >
        <controls:StripeBack>
            <Label Name="ScannerStateLabel" HorizontalAlignment="Center" StyleClasses="Highlight" Margin="4 0 0 4" />
        </controls:StripeBack>
            <BoxContainer Orientation = "Horizontal" HorizontalExpand = "True">
                <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#202023"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation = "Vertical" HorizontalExpand = "True"  HorizontalAlignment="Center" VerticalAlignment="Center">
                        <SpriteView OverrideDirection="South" Scale = "2 2" Name = "SpriteView" SetSize="64 64"/>
                        <TextureRect Name="NoDataTex" Access="Public" SetSize="64 64" Visible="false" Stretch="KeepAspectCentered" TexturePath="/Textures/Interface/Misc/health_analyzer_out_of_range.png"/>
                    </BoxContainer>
                </PanelContainer>
            <PanelContainer HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#202023"/>
            </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <Label Name="NodesClearedLabel"
                            HorizontalAlignment="Center"
                            HorizontalExpand="True"
                            Text="{Loc 'alienrock-scanner-info-empty'}" />
                        <GridContainer Name="NodesList"
                            HorizontalAlignment="Center"
                            HorizontalExpand="True"
                            Columns="1" Rows="6" />
                    </BoxContainer>
            </PanelContainer>
            </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
